{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/dashboard/index.html" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/simulator", "destination": "/simulator/index.html" },
    { "source": "/chat", "destination": "/whatsapp-mockup/index.html" },
    { "source": "/banner", "destination": "/upwork/banner_4x3_template.html" },
    { "source": "/dashboard/(.*)", "destination": "/dashboard/$1" },
    { "source": "/simulator/(.*)", "destination": "/simulator/$1" },
    { "source": "/whatsapp-mockup/(.*)", "destination": "/whatsapp-mockup/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|png|jpg|mp4|svg|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
